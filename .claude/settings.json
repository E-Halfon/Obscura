{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh\""
          }
        ]
      }
    ]
  }
}
