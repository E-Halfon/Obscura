# Camera Obscura capability: virt (ARCHITECTURE.md §4).
# Active = present, inactive = absent. Never "failed".
# Started only by udev (70-obscura-cap-virt.rules) through SYSTEMD_WANTS when matching
# hardware appears. StopWhenUnneeded stops it once the last matching device is gone.
# Manual start and stop are refused so the state can't be faked; tests use real or
# virtual devices. Units that belong to this capability use PartOf= and
# WantedBy= this target and must never Requires= or Wants= it.
[Unit]
Description=Obscura capability: Hardware virtualization (AMD-V / VT-x) usable by KVM
Documentation=file:/usr/share/obscura/capabilities.d/virt.toml
StopWhenUnneeded=yes
RefuseManualStart=yes
RefuseManualStop=yes
