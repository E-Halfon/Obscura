# Camera Obscura capability probe: vulkan-1.3 for one DRM render node (task 0.2b).
# Instance = the render node (renderD128). Started by 70-obscura-cap-vulkan-1.3.rules when
# the node appears; Vulkan never runs inside the udev worker.
#
# ExecCondition= runs the probe (obscura_capd.vulkan_probe). Exit 0: the node has a
# hardware-accelerated Vulkan 1.3 device, the unit becomes active and Upholds= the
# capability target. Exit 1: it doesn't, or the probe couldn't tell; systemd skips the unit
# (inactive, result exec-condition, never failed) and it upholds nothing.
# BindsTo= the device: when the GPU goes, this unit stops, and once no active probe
# upholds the target, StopWhenUnneeded stops it (vulkan-1.3 absent, no reboot).
#
# This is the one kind of unit allowed to pull in a capability target, and only its own
# (tests/unit/test_repo_consistency.py). Starting it by hand only reruns real detection.
#
# Hardening: obscura-capd.service's, except DynamicUser= with the render group instead
# of a fixed user, and DevicePolicy=closed + DeviceAllow=char-drm instead of
# PrivateDevices=, because the probe needs /dev/dri and nothing else. NVIDIA's proprietary
# driver also needs /dev/nvidia*, so it reads absent here (fails safe; open item in the
# build brief). MemoryDenyWriteExecute= stays off: Mesa may JIT while enumerating devices.
[Unit]
Description=Obscura capability probe: hardware Vulkan 1.3 on %i
Documentation=file:/usr/share/obscura/capabilities.d/vulkan-1.3.toml
BindsTo=dev-dri-%i.device
After=dev-dri-%i.device
Upholds=obscura-cap-vulkan-1.3.target
# Coldplug probes settle before login; the probe's own deadline caps the wait at 45 s.
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/usr/bin/python3 -P -m obscura_capd.vulkan_probe %i
ExecStart=/usr/bin/true
TimeoutStartSec=90
Environment=PYTHONPATH=/usr/lib/obscura/python PYTHONDONTWRITEBYTECODE=1 MESA_SHADER_CACHE_DISABLE=true
UnsetEnvironment=VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_INSTANCE_LAYERS VK_LAYER_PATH VK_ADD_LAYER_PATH VK_LOADER_LAYERS_ENABLE MESA_VK_DEVICE_SELECT

DynamicUser=yes
SupplementaryGroups=render
DevicePolicy=closed
DeviceAllow=char-drm rw

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
UMask=0077
